# =============================================================================
# blog-backend 生产环境变量清单（fatwill.cn 域名切换版）
# =============================================================================
# 用途：交付运维，用于更新 systemd unit 的 Environment= 配置。
# 对应二进制：dist/blog-backend（linux/amd64，静态链接，无 CGO 依赖）
# 部署目标：203.195.213.129 → /root/blog-backend/blog-backend
#
# 说明：
#   代码中每个变量都有默认值（config/config.go），本文件是「生产期望值」的显式固化。
#   标注 🔴 的必须由运维在生产覆盖（含密钥，本文件不落明文）。
#   标注 🟡 的与本次域名切换相关，需确认已按下方取值生效。
#   标注 ⚪ 的与代码默认值一致，可不显式设置。
# =============================================================================

# ---------- 服务 ----------
# ⚪ 服务监听端口（Nginx 反代到此端口，本次不改 Nginx）
SERVER_PORT=8080

# 🟡 允许跨域来源，逗号分隔多值。默认放行主域及 www 子域
CORS_ORIGIN=https://fatwill.cn,https://www.fatwill.cn

# 🟡 站点根 URL，决定微信同步「原文链接」等生成的绝对地址，必须为新主域
SITE_URL=https://fatwill.cn

# ---------- 数据库（SQLite，非 MySQL） ----------
# ⚪ SQLite 单文件路径。升级二进制时请勿改动，否则会创建空库丢失数据
DB_PATH=/root/blog-data/blog.db

# ---------- Redis ----------
# ⚪ 本机 Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 🔴 Redis 密码：沿用生产现值，勿置空（置空会导致鉴权/主题/微信 token 缓存全部失效）
# REDIS_PASSWORD=<沿用生产现值>

# ---------- 上传 ----------
# ⚪ 分片上传临时目录
UPLOAD_DIR=/root/blog-uploads
UPLOAD_TMP_DIR=/root/blog-uploads/tmp

# ---------- 腾讯云 COS ----------
# 🔴 密钥：沿用生产现值，不要写入 Git
# COS_SECRET_ID=<沿用生产现值>
# COS_SECRET_KEY=<沿用生产现值>

# ⚪ 存储桶标识与站点域名无关，本次域名切换【不要改】
COS_BUCKET=fatwill-cloud-1253664788
COS_REGION=ap-guangzhou
COS_BASE_URL=https://fatwill-cloud-1253664788.cos.ap-guangzhou.myqcloud.com

# 🟡 新上传资源对外返回的自定义域名（已切 .cn）
COS_CUSTOM_DOMAIN=https://assets.fatwill.cn

# 🟡 历史自定义域名，逗号分隔。仅用于 DeleteFromCOS 反解存量 URL 的 object key，
#    不用于生成新 URL。缺失会导致历史域名存量图片删不掉（COS 侧残留垃圾对象）
COS_LEGACY_DOMAINS=https://cdn.fatwill.cn

# ---------- 下载代理白名单 ----------
# 🟡 /api/download 允许代理的域名，逗号分隔。覆盖站点资源子域与 COS 原始 endpoint
DOWNLOAD_ALLOWED_HOSTS=assets.fatwill.cn,cdn.fatwill.cn,pic.fatwill.cn,fatwill-cloud-1253664788.cos.ap-guangzhou.myqcloud.com

# ---------- 微信公众号 ----------
# 🔴 密钥：沿用生产现值
# WECHAT_APP_ID=<沿用生产现值>
# WECHAT_APP_SECRET=<沿用生产现值>

# ---------- IP 地理位置 ----------
# ⚪ ip2region 数据文件路径（相对二进制工作目录，需与 data/ 一同部署）
IP2REGION_PATH=data/ip2region.xdb
