# MySQL 数据库连接配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=blog

# 管理后台账号（必填）
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password

# 腾讯云 COS 配置
COS_ID=your-cos-secret-id
COS_KEY=your-cos-secret-key
COS_BUCKET=fatwill-cloud-1253664788
COS_REGION=ap-guangzhou
COS_BASE_URL=https://assets.fatwill.cloud

# ====== 站点域名配置（换域名只需改这三项） ======
# 站点主域名：canonical / OG / sitemap.xml / robots.txt / 分享链接
NUXT_PUBLIC_SITE_URL=https://fatwill.cloud
# 图片与静态素材 CDN（COS 自定义域名）：文章封面、相册、SBTI 人格图等
NUXT_PUBLIC_ASSETS_URL=https://assets.fatwill.cloud
# Nuxt 构建产物 CDN（⚠️ 构建期常量，改动后必须重新 npm run build 才生效）
NUXT_PUBLIC_CDN_URL=https://cdn.fatwill.cloud
