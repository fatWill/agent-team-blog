# ====== 生产环境站点域名配置 ======
# ⚠️ Nuxt 3 默认只自动加载 `.env`，本文件不会被 `nuxt build` 自动读取。
# 构建时请显式导出这三个变量，或使用 scripts/build-prod.sh。
# 例：set -a && source .env.production && set +a && npm run build

# 站点主域名：canonical / OG / sitemap.xml / robots.txt / 分享链接
NUXT_PUBLIC_SITE_URL=https://fatwill.cn

# 图片与静态素材 CDN（腾讯云 COS 自定义域名）：文章封面、相册、SBTI 人格图等
NUXT_PUBLIC_ASSETS_URL=https://assets.fatwill.cn

# Nuxt 构建产物 CDN（⚠️ 构建期常量 app.cdnURL，改动后必须重新 npm run build 才生效）
NUXT_PUBLIC_CDN_URL=https://cdn.fatwill.cn
